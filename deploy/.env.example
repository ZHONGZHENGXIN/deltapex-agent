######## 环境与服务 ########
# env
ENV=prod

# url
NEXT_PUBLIC_API_URL=http://127.0.0.1:8081
NEXT_PUBLIC_APP_URL=http://127.0.0.1:8081
NEXT_PUBLIC_DOCS_URL=http://127.0.0.1:8082
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_RESET_REDIRECT_URL=http://127.0.0.1:8081/zh/reset-password

# nginx
NGINX_PORT=8081
NGINX_SERVER_NAME=localhost

# api
API_NAME=bait-api
API_VERSION=0.1
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False
TRACE_ID_HEADER=X-Trace-Id
LOG_HOT_RETENTION_DAYS=30
LOG_COLD_RETENTION_DAYS=90

# docs
DOCS_NODE_ENV=production
DOCS_PORT=4000
DOCS_EXPOSE_PORT=8082

# supabase auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

######## 存储 ########
# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=bait
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_EXPOSE_PORT=15432

# db settings
POSTGRES_ECHO=False
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=30
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
POSTGRES_POOL_PRE_PING=True

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_EXPOSE_PORT=16379

######## 通知 ########
# send mail (SMTP/RESEND)
MAIL_SEND_METHOD=SMTP

# smtp (大多数云厂商可能会封禁)
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=123456
MAIL_FROM=no-reply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com

# resend
RESEND_API_KEY=re_1234
RESEND_MAIL_FROM=onboarding@resend.dev

######## 大模型与 Agent ########
# default fastgpt agent
AGENT_API_KEY=fastgpt-app-key
AGENT_BASE_URL=https://api.fastgpt.ai/api/v1/chat/completions
AGENT_MODEL_NAME=fastgpt
LLM_GATEWAY_ENABLED=false
LLM_GATEWAY_BASE_URL=http://one-api:3000/v1
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL_NAME=fastgpt

######## 会员与支付 ########
# stripe pay
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_PRIVATE_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_cexxx

# membership plan
MEMBERSHIP_FREE_NAME=免费会员
MEMBERSHIP_FREE_DAILY_MESSAGE_LIMIT=10
MEMBERSHIP_FREE_DAILY_TOKEN_LIMIT=10000
MEMBERSHIP_FREE_CONVERSATION_TURN_LIMIT=10
MEMBERSHIP_FREE_PRICE=0.0
MEMBERSHIP_FREE_CURRENCY=USD
MEMBERSHIP_FREE_DURATION_DAYS=36500
MEMBERSHIP_FREE_DESCRIPTION=免费用户基础计划

# membership plan
MEMBERSHIP_MONTHLY_NAME=月度会员
MEMBERSHIP_MONTHLY_DAILY_MESSAGE_LIMIT=100
MEMBERSHIP_MONTHLY_DAILY_TOKEN_LIMIT=1000000
MEMBERSHIP_MONTHLY_CONVERSATION_TURN_LIMIT=30
MEMBERSHIP_MONTHLY_PRICE=9.9
MEMBERSHIP_MONTHLY_CURRENCY=USD
MEMBERSHIP_MONTHLY_DURATION_DAYS=30
MEMBERSHIP_MONTHLY_DESCRIPTION=月度付费会员计划

# membership plan
MEMBERSHIP_YEARLY_NAME=年度会员
MEMBERSHIP_YEARLY_DAILY_MESSAGE_LIMIT=1000
MEMBERSHIP_YEARLY_DAILY_TOKEN_LIMIT=2000000
MEMBERSHIP_YEARLY_CONVERSATION_TURN_LIMIT=50
MEMBERSHIP_YEARLY_PRICE=99.9
MEMBERSHIP_YEARLY_CURRENCY=USD
MEMBERSHIP_YEARLY_DURATION_DAYS=365
MEMBERSHIP_YEARLY_DESCRIPTION=年度付费会员计划
